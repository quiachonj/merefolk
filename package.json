{
	"name": "merefolk",
	"version": "1.0.3",
	"description": "Obsidian plugin that renders Mermaid entity-relationship diagrams as native, editable Excalidraw drawings — crow's-foot cardinality, clean ELK auto-layout, theme-aware tables, with edits that persist.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"keywords": [
		"obsidian",
		"excalidraw",
		"mermaid",
		"er-diagram"
	],
	"author": "Amberlogica",
	"license": "MIT",
	"dependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"elkjs": "^0.12.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.14.4",
		"prettier": "^3.10.1",
		"tslib": "^2.9.1",
		"typescript": "^5.4.0"
	},
	"overrides": {
		"nanoid": "5.1.16",
		"lodash-es": "^4.18.1",
		"dompurify": "^3.4.17",
		"katex": "^0.19.1",
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		},
		"eslint-plugin-n": {
			"minimatch": "^11.0.1"
		}
	}
}
