{
	"name": "merefolk",
	"version": "1.0.1",
	"description": "Obsidian plugin that renders Mermaid entity-relationship diagrams as native, editable Excalidraw drawings — crow's-foot cardinality, clean ELK auto-layout, theme-aware tables, with edits that persist.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"keywords": [
		"obsidian",
		"excalidraw",
		"mermaid",
		"er-diagram"
	],
	"author": "Amberlogica",
	"license": "MIT",
	"dependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"elkjs": "^0.12.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"prettier": "^3.2.5",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0"
	},
	"overrides": {
		"nanoid": "^3.3.8"
	}
}
