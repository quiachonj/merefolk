{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "Bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2018"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx"
	]
}
